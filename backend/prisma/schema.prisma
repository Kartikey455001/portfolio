generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id                 String   @id @default(cuid())
  name               String
  headline           String
  bio                String
  location           String
  email              String
  resumeUrl          String?
  githubUsername     String?
  leetcodeUsername   String?
  linkedinProfileUrl String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Project {
  id               String   @id @default(cuid())
  githubId         BigInt?  @unique
  name             String
  slug             String   @unique
  description      String?
  htmlUrl          String
  liveUrl          String?
  language         String?
  topics           String[] @default([])
  stars            Int      @default(0)
  forks            Int      @default(0)
  readme           String?
  imageUrl         String?
  owner            String?
  defaultBranch    String?
  isFeatured       Boolean  @default(false)
  displayOrder     Int      @default(0)
  githubUpdatedAt  DateTime?
  isAvailable      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isFeatured, displayOrder, githubUpdatedAt, stars])
}


model LeetCodeStats {
  id                 String   @id @default(cuid())
  username           String   @unique
  totalSolved        Int
  easySolved         Int
  mediumSolved       Int
  hardSolved         Int
  ranking            Int?
  currentStreak      Int      @default(0)
  longestStreak      Int      @default(0)
  totalSubmissions   Int
  submissionCalendar Json
  fetchedAt          DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Achievement {
  id            String   @id @default(cuid())
  title         String
  description   String
  organization  String?
  year          String
  icon          String?
  displayOrder  Int      @default(0)
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isPublished, displayOrder])
}

model Experience {
  id             String    @id @default(cuid())
  company        String
  role           String
  description    String?
  startDate      DateTime?
  endDate        DateTime?
  location       String?
  employmentType String?
  technologies   String[]  @default([])
  displayOrder   Int       @default(0)
  isPublished    Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isPublished, displayOrder])
}

model Skill {
  id           String   @id @default(cuid())
  name         String   @unique
  category     String
  icon         String?
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished, displayOrder])
}

model SyncLog {
  id           String    @id @default(cuid())
  provider     String
  operation    String
  status       String
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  itemsFetched Int       @default(0)
  errorMessage String?   @db.Text
  durationMs   Int?
  deliveryId   String?   @unique

  @@index([provider, startedAt])
  @@index([provider, status, completedAt])
}

model Integration {
  id                    String   @id @default(cuid())
  provider              String   @unique
  status                String   @default("NOT_CONNECTED")
  metadata              Json?
  lastSuccessfulSync    DateTime?
  lastAttemptedSync     DateTime?
  itemsFetched          Int      @default(0)
  lastError             String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model AdminSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
